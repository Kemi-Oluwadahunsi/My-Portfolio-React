# EmailJS Configuration
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Contact Information
VITE_CONTACT_EMAIL=your_email@example.com
VITE_CONTACT_PHONE_1=your_phone_1
VITE_CONTACT_PHONE_2=your_phone_2
VITE_WHATSAPP_LINK=https://wa.me/your_number
VITE_WHATSAPP_LINK_NG=https://wa.me/your_number_2

# Social Links
VITE_LINKEDIN_URL=https://linkedin.com/in/your_profile/
VITE_FACEBOOK_URL=https://www.facebook.com/your_profile
VITE_TWITTER_URL=https://twitter.com/your_handle
VITE_GITHUB_URL=https://github.com/your_username/

# Ebook Sales Links
VITE_MFE_BOOK1_SELAR_URL=https://selar.co/your_book

# Portfolio chatbot (server-side only: never prefix with VITE_)
# Run `npm run chatbot:knowledge` once (and after content changes) to build its knowledge base.
OPENAI_API_KEY=
# Optional: any chat-completions model; defaults to gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

